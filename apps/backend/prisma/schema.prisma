generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransferRequestStatus {
  PENDING_RECEIPT
  RECEIVED
  CANCELLED
}

enum ManagerLicenseStatus {
  PENDING
  ACTIVE
  LINKED
  CANCELLED
  EXPIRED
}

enum ManagerLicenseType {
  MONTHLY
  ANNUAL
  LIFETIME
  TRIAL
}

enum ManagerBillingStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum ManagerGatewayProvider {
  MERCADO_PAGO
}

enum ManagerBillingPaymentMethod {
  PIX
  BOLETO
}

enum ManagerBillingPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum FleetVehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  TRANSFERRED
  DISPOSED
}

enum FleetDriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FleetMaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  EMERGENCY
}

enum FleetMaintenanceStatus {
  OPEN
  IN_PROGRESS
  WAITING_PART
  COMPLETED
  CANCELLED
}

enum FleetPrimaryControlUnit {
  KM
  HOURS
  BOTH
}

model User {
  id                       String            @id @default(cuid())
  name                     String
  email                    String            @unique
  passwordHash             String            @default("")
  role                     UserRole          @default(ADMIN)
  active                   Boolean           @default(true)
  isDefaultAdmin           Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  movements                StockMovement[]
  warehouseAssignments     UserWarehouse[]
  requestedEntries         EntryRequest[]    @relation("EntryRequester")
  reviewedEntries          EntryRequest[]    @relation("EntryReviewer")
  createdTransfers         TransferRequest[] @relation("TransferCreator")
  receivedTransfers        TransferRequest[] @relation("TransferReceiver")
  auditLogs                AuditLog[]
  fleetReadings            FleetVehicleReading[] @relation("FleetReadingUser")
  fleetAllocations         FleetVehicleAllocation[] @relation("FleetAllocationUser")
  fleetTransfers           FleetVehicleTransfer[] @relation("FleetTransferUser")
  fleetMaintenances        FleetMaintenance[] @relation("FleetMaintenanceUser")
}

model WarehouseCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  color       String?
  icon        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  warehouses  Warehouse[]
}

model Warehouse {
  id                        String            @id @default(cuid())
  name                      String            @unique
  description               String?
  categoryId                String
  isGeneral                 Boolean           @default(false)
  active                    Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  category                  WarehouseCategory @relation(fields: [categoryId], references: [id])
  stocks                    Stock[]
  movements                 StockMovement[]   @relation("WarehouseMovements")
  outgoingTransfers         StockMovement[]   @relation("MovementSourceWarehouse")
  incomingTransfers         StockMovement[]   @relation("MovementDestinationWarehouse")
  userAssignments           UserWarehouse[]
  entryRequests             EntryRequest[]
  outgoingTransferRequests  TransferRequest[] @relation("TransferRequestSource")
  incomingTransferRequests  TransferRequest[] @relation("TransferRequestDestination")
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model UnitOfMeasure {
  id                      String             @id @default(cuid())
  name                    String             @unique
  abbreviation            String             @unique
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  products                Product[]
  unitConversionsFrom     UnitConversion[]   @relation("UnitConversionFromUnit")
  sourceMovements         StockMovement[]    @relation("StockMovementSourceUnit")
  sourceEntryRequests     EntryRequest[]     @relation("EntryRequestSourceUnit")
  sourceEntryRequestItems EntryRequestItem[] @relation("EntryRequestItemSourceUnit")
  sourceTransferRequests  TransferRequest[]  @relation("TransferRequestSourceUnit")
}

model Product {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String?
  categoryId       String
  unitId           String
  minimumQuantity  Int               @default(0)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  unit             UnitOfMeasure     @relation(fields: [unitId], references: [id])
  stocks           Stock[]
  movements        StockMovement[]
  entryRequests    EntryRequest[]
  entryRequestItems EntryRequestItem[]
  transferRequests TransferRequest[]
  unitConversions  UnitConversion[]
}

model UnitConversion {
  id           String        @id @default(cuid())
  productId    String
  fromUnitId   String
  factorToBase Decimal
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit     UnitOfMeasure @relation("UnitConversionFromUnit", fields: [fromUnitId], references: [id])

  @@unique([productId, fromUnitId])
  @@index([fromUnitId])
}

model UserWarehouse {
  id          String    @id @default(cuid())
  userId      String
  warehouseId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([userId, warehouseId])
}

model Stock {
  id              String    @id @default(cuid())
  warehouseId     String
  productId       String
  currentQuantity Int       @default(0)
  minimumQuantity Int       @default(0)
  unitPriceAverage Decimal   @default(0)
  totalValue      Decimal    @default(0)
  lastMovementAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
  movements       StockMovement[]

  @@unique([warehouseId, productId])
}

model StockMovement {
  id                     String       @id @default(cuid())
  type                   MovementType
  warehouseId            String
  productId              String
  sourceWarehouseId      String?
  destinationWarehouseId String?
  quantity               Int
  unitPrice              Decimal?
  sourceQuantity         Decimal?
  sourceUnitId           String?
  conversionFactor       Decimal?
  sourceUnitPrice        Decimal?
  destinationNote        String?
  observation            String?
  invoiceId              String?
  stockId                String?
  movementDate           DateTime
  responsibleUserId      String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  warehouse              Warehouse    @relation("WarehouseMovements", fields: [warehouseId], references: [id])
  sourceWarehouse        Warehouse?   @relation("MovementSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse?   @relation("MovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  product                Product      @relation(fields: [productId], references: [id])
  responsibleUser        User         @relation(fields: [responsibleUserId], references: [id])
  invoice                Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  stock                  Stock?       @relation(fields: [stockId], references: [id], onDelete: Cascade)
  sourceUnit             UnitOfMeasure? @relation("StockMovementSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)

  @@index([stockId])
  @@index([sourceUnitId])
}

model EntryRequest {
  id               String        @id @default(cuid())
  warehouseId      String
  productId        String
  quantity         Int
  sourceQuantity   Decimal?
  sourceUnitId     String?
  conversionFactor Decimal?
  observation      String?
  movementDate     DateTime
  status           RequestStatus @default(PENDING)
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  officeNumber     Int?
  officeYear       Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  warehouse        Warehouse     @relation(fields: [warehouseId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])
  requestedBy      User          @relation("EntryRequester", fields: [requestedById], references: [id])
  reviewedBy       User?         @relation("EntryReviewer", fields: [reviewedById], references: [id])
  sourceUnit        UnitOfMeasure? @relation("EntryRequestSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)
  items            EntryRequestItem[]

  @@unique([warehouseId, officeYear, officeNumber])
  @@index([sourceUnitId])
}

model EntryRequestItem {
  id               String       @id @default(cuid())
  requestId        String
  productId        String
  quantity         Int
  sourceQuantity   Decimal?
  sourceUnitId     String?
  conversionFactor Decimal?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  request          EntryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id])
  sourceUnit       UnitOfMeasure? @relation("EntryRequestItemSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([productId])
  @@index([sourceUnitId])
}

model TransferRequest {
  id                     String                @id @default(cuid())
  sourceWarehouseId      String
  destinationWarehouseId String
  productId              String
  quantity               Int
  sourceQuantity         Decimal?
  sourceUnitId           String?
  conversionFactor       Decimal?
  observation            String?
  movementDate           DateTime
  status                 TransferRequestStatus @default(PENDING_RECEIPT)
  createdById            String
  receivedById           String?
  receivedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  sourceWarehouse        Warehouse             @relation("TransferRequestSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse             @relation("TransferRequestDestination", fields: [destinationWarehouseId], references: [id])
  product                Product               @relation(fields: [productId], references: [id])
  createdBy              User                  @relation("TransferCreator", fields: [createdById], references: [id])
  receivedBy             User?                 @relation("TransferReceiver", fields: [receivedById], references: [id])
  sourceUnit             UnitOfMeasure?        @relation("TransferRequestSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)

  @@index([sourceUnitId])
}

model Invoice {
  id                    String          @id @default(cuid())
  supplierId            String?
  companyName           String
  companyTradeName      String?
  cnpj                  String
  stateRegistration     String?
  municipalRegistration String?
  companyAddress        String?
  companyCity           String?
  companyState          String?
  companyZipCode        String?
  companyPhone          String?
  invoiceKey            String?         @unique
  number                String
  series                String?
  issueDate             DateTime
  totalValue            Decimal         @default(0)
  observation           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  supplier              Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements             StockMovement[]

  @@index([supplierId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model Supplier {
  id                    String    @id @default(cuid())
  name                  String
  tradeName             String?
  cnpj                  String    @unique
  stateRegistration     String?
  municipalRegistration String?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  phone                 String?
  email                 String?
  notes                 String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  invoices              Invoice[]

  @@index([active])
  @@index([name])
}

model OfficeLetterTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  subject     String
  contentHtml String
  variables   String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([name])
}

model SystemSettings {
  id                    String   @id @default("system")
  systemName            String   @default("Prefeitura")
  faviconUrl            String?
  logoUrl               String?
  officeLogoUrl         String?
  primaryColor          String   @default("#0f766e")
  loginBackgroundUrl    String?
  loginTitle            String   @default("Almoxarifado Municipal")
  loginSubtitle         String   @default("Entre com seu usuario para acompanhar o estoque municipal.")
  loginImageUrl         String?
  reportLogoUrl         String?
  reportTitle           String   @default("GEMA - Gestao Municipal de Almoxarifado")
  reportPrimaryColor    String   @default("#0f766e")
  reportFooterText      String   @default("Documento gerado pelo sistema de almoxarifado municipal.")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default("site")
  siteName          String   @default("GEMA Sistemas")
  eyebrow           String   @default("Solucoes para gestao publica")
  headline          String   @default("Sistemas municipais para controlar rotinas criticas")
  subheadline       String   @default("Frota e almoxarifado em uma plataforma pensada para equipes publicas que precisam de controle, rastreabilidade e suporte proximo.")
  primaryCtaLabel   String   @default("Falar com especialista")
  secondaryCtaLabel String   @default("Conhecer solucoes")
  heroImageUrl      String?
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String   @default("#0f766e")
  whatsappNumber    String   @default("5599999999999")
  whatsappMessage   String   @default("Ola, quero conhecer os sistemas municipais.")
  contactEmail      String?
  footerText        String   @default("GEMA Sistemas - tecnologia para gestao publica.")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SiteBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  buttonLabel String?
  buttonUrl   String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model SiteSystem {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  summary      String
  description  String?
  imageUrl     String?
  featuresJson String   @default("[]")
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model SiteFeature {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  group       String   @default("benefits")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([group])
  @@index([sortOrder])
}

model SitePost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  summary       String
  content       String
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
}

model SitePlan {
  id           String   @id @default(cuid())
  name         String
  description  String
  featuresJson String   @default("[]")
  badge        String?
  ctaLabel     String   @default("Consultar")
  highlighted  Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model SiteFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model ManagerSubscriber {
  id        String           @id @default(cuid())
  name      String
  document  String?          @unique
  email     String           @unique
  phone     String?
  city      String?
  state     String?
  notes     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  licenses  ManagerLicense[]
  billings  ManagerBilling[]
}

model ManagerLicense {
  id                 String               @id @default(cuid())
  subscriberId       String
  systemKey          String
  licenseKey         String               @unique
  type               ManagerLicenseType   @default(MONTHLY)
  status             ManagerLicenseStatus @default(ACTIVE)
  seats              Int                  @default(1)
  startsAt           DateTime             @default(now())
  expiresAt          DateTime?
  validatedAt        DateTime?
  linkedAt           DateTime?
  linkedDomain       String?
  linkedIp           String?
  linkedUserAgent    String?
  lastValidationAt   DateTime?
  lastValidationDomain String?
  lastValidationIp   String?
  lastValidationUserAgent String?
  validationCount    Int                  @default(0)
  validationBlockedAt DateTime?
  validationBlockedReason String?
  cancelledAt        DateTime?
  cancellationReason String?
  monthlyValue       Decimal              @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  subscriber         ManagerSubscriber    @relation(fields: [subscriberId], references: [id])
  billings           ManagerBilling[]

  @@index([subscriberId])
  @@index([systemKey])
  @@index([status])
  @@index([expiresAt])
}

model ManagerBilling {
  id           String               @id @default(cuid())
  subscriberId String
  licenseId    String?
  systemKey    String
  reference    String
  description  String?
  amount       Decimal              @default(0)
  dueDate      DateTime
  paidAt       DateTime?
  status       ManagerBillingStatus @default(OPEN)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  subscriber   ManagerSubscriber    @relation(fields: [subscriberId], references: [id])
  license      ManagerLicense?      @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  payments     ManagerBillingPayment[]

  @@index([subscriberId])
  @@index([licenseId])
  @@index([systemKey])
  @@index([status])
  @@index([dueDate])
}

model ManagerPaymentGatewayConfig {
  id            String                 @id @default(cuid())
  provider      ManagerGatewayProvider @unique
  label         String
  active        Boolean                @default(false)
  publicKey     String?
  accessToken   String?
  clientId      String?
  clientSecret  String?
  refreshToken  String?
  webhookSecret String?
  accountId     String?
  liveMode      Boolean                @default(false)
  connectedAt   DateTime?
  tokenExpiresAt DateTime?
  oauthState    String?
  oauthStateExpiresAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  payments      ManagerBillingPayment[]
}

model ManagerBillingPayment {
  id                   String                      @id @default(cuid())
  billingId            String
  gatewayConfigId      String?
  provider             ManagerGatewayProvider
  method               ManagerBillingPaymentMethod
  status               ManagerBillingPaymentStatus @default(PENDING)
  providerPaymentId    String?
  externalReference    String                      @unique
  amount               Decimal                     @default(0)
  statusDetail         String?
  qrCode               String?
  qrCodeBase64         String?
  ticketUrl            String?
  barcode              String?
  rawPayload           String?
  expiresAt            DateTime?
  paidAt               DateTime?
  cancelledAt          DateTime?
  refundedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  billing              ManagerBilling              @relation(fields: [billingId], references: [id], onDelete: Cascade)
  gatewayConfig        ManagerPaymentGatewayConfig? @relation(fields: [gatewayConfigId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([billingId])
  @@index([gatewayConfigId])
  @@index([provider])
  @@index([status])
}

model LicenseValidationState {
  id          String    @id @default("system")
  mode        String    @default("unmanaged")
  licenseKey  String?
  status      String    @default("UNMANAGED")
  valid       Boolean   @default(true)
  blockWrites Boolean   @default(false)
  checkedAt   DateTime?
  nextCheckAt DateTime?
  expiresAt   DateTime?
  message     String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([licenseKey])
  @@index([status])
}

model FleetStructure {
  id                     String                   @id @default(cuid())
  name                   String                   @unique
  type                   String?
  active                 Boolean                  @default(true)
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  currentVehicles        FleetVehicle[]           @relation("FleetCurrentStructure")
  readings               FleetVehicleReading[]
  originAllocations      FleetVehicleAllocation[] @relation("FleetAllocationOrigin")
  destinationAllocations FleetVehicleAllocation[] @relation("FleetAllocationDestination")
  originTransfers        FleetVehicleTransfer[]   @relation("FleetTransferOrigin")
  destinationTransfers   FleetVehicleTransfer[]   @relation("FleetTransferDestination")
}

model FleetDriver {
  id             String                 @id @default(cuid())
  name           String
  cpf            String?                @unique
  phone          String?
  email          String?
  licenseNumber  String?
  licenseCategory String?
  licenseIssuedAt DateTime?
  licenseExpiresAt DateTime?
  licenseStatus String?
  status         FleetDriverStatus      @default(ACTIVE)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  currentVehicles FleetVehicle[]        @relation("FleetCurrentDriver")
  readings       FleetVehicleReading[]
  fuelings       FleetFueling[]
  transfers      FleetVehicleTransfer[]
}

model FleetVehicle {
  id                  String                    @id @default(cuid())
  plate               String                    @unique
  renavam             String?
  chassis             String?
  vehicleType         String
  brand               String
  model               String
  manufactureYear     Int?
  modelYear           Int?
  color               String?
  fuelType            String
  tankCapacity        Decimal                   @default(0)
  status              FleetVehicleStatus        @default(ACTIVE)
  currentOdometer     Int                       @default(0)
  currentHourmeter    Decimal?
  currentStructureId  String?
  currentDriverId     String?
  acquisitionDate     DateTime?
  acquisitionValue    Decimal                   @default(0)
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  currentStructure    FleetStructure?           @relation("FleetCurrentStructure", fields: [currentStructureId], references: [id], onDelete: SetNull)
  currentDriver       FleetDriver?              @relation("FleetCurrentDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  readings            FleetVehicleReading[]
  fuelings            FleetFueling[]
  allocations         FleetVehicleAllocation[]
  transfers           FleetVehicleTransfer[]
  maintenances        FleetMaintenance[]
  scheduledServices   FleetScheduledService[]
  oilControls         FleetOilControl[]
  beltControls        FleetBeltControl[]
  tires               FleetTire[]

  @@index([currentStructureId])
  @@index([currentDriverId])
  @@index([status])
}

model FleetVehicleReading {
  id             String          @id @default(cuid())
  vehicleId      String
  driverId       String?
  structureId    String?
  registeredById String?
  readingDate    DateTime
  odometer       Int?
  hourmeter      Decimal?
  notes          String?
  createdAt      DateTime        @default(now())
  vehicle        FleetVehicle    @relation(fields: [vehicleId], references: [id])
  driver         FleetDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  structure      FleetStructure? @relation(fields: [structureId], references: [id], onDelete: SetNull)
  registeredBy   User?           @relation("FleetReadingUser", fields: [registeredById], references: [id], onDelete: SetNull)

  @@index([vehicleId, readingDate])
}

model FleetFueling {
  id             String       @id @default(cuid())
  vehicleId      String
  driverId       String?
  fuelingDate    DateTime
  fuelType       String
  quantity       Decimal
  unitPrice      Decimal
  totalPrice     Decimal
  supplier       String?
  odometer       Int?
  hourmeter      Decimal?
  fiscalDocument String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  vehicle        FleetVehicle @relation(fields: [vehicleId], references: [id])
  driver         FleetDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId, fuelingDate])
  @@index([driverId])
}

model FleetVehicleAllocation {
  id                     String          @id @default(cuid())
  vehicleId              String
  originStructureId      String?
  destinationStructureId String
  driverId               String?
  responsibleUserId      String?
  startDate              DateTime
  endDate                DateTime?
  reason                 String?
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  vehicle                FleetVehicle    @relation(fields: [vehicleId], references: [id])
  originStructure        FleetStructure? @relation("FleetAllocationOrigin", fields: [originStructureId], references: [id], onDelete: SetNull)
  destinationStructure   FleetStructure  @relation("FleetAllocationDestination", fields: [destinationStructureId], references: [id])
  responsibleUser        User?           @relation("FleetAllocationUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, endDate])
  @@index([destinationStructureId])
}

model FleetVehicleTransfer {
  id                     String          @id @default(cuid())
  vehicleId              String
  originStructureId      String?
  destinationStructureId String
  transferDate           DateTime
  responsibleUserId      String?
  driverId               String?
  odometer               Int?
  hourmeter              Decimal?
  vehicleCondition       String?
  notes                  String?
  createdAt              DateTime        @default(now())
  vehicle                FleetVehicle    @relation(fields: [vehicleId], references: [id])
  originStructure        FleetStructure? @relation("FleetTransferOrigin", fields: [originStructureId], references: [id], onDelete: SetNull)
  destinationStructure   FleetStructure  @relation("FleetTransferDestination", fields: [destinationStructureId], references: [id])
  responsibleUser        User?           @relation("FleetTransferUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  driver                 FleetDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId, transferDate])
}

model FleetMaintenance {
  id                 String                 @id @default(cuid())
  vehicleId          String
  type               FleetMaintenanceType
  status             FleetMaintenanceStatus @default(OPEN)
  openedAt           DateTime
  completedAt        DateTime?
  problemDescription String
  performedServices  String?
  partsUsed          String?
  supplier           String?
  laborCost          Decimal                @default(0)
  partsCost          Decimal                @default(0)
  totalCost          Decimal                @default(0)
  odometer           Int?
  hourmeter          Decimal?
  responsibleUserId  String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  vehicle            FleetVehicle           @relation(fields: [vehicleId], references: [id])
  responsibleUser    User?                  @relation("FleetMaintenanceUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, openedAt])
  @@index([status])
}

model FleetScheduledService {
  id              String       @id @default(cuid())
  vehicleId       String?
  vehicleType     String?
  serviceType     String
  intervalKm      Int?
  intervalHours   Decimal?
  intervalDays    Int?
  limitDate       DateTime?
  triggerFirst    Boolean      @default(true)
  active          Boolean      @default(true)
  lastDoneAt      DateTime?
  lastOdometer    Int?
  lastHourmeter   Decimal?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  vehicle         FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleType])
}

model FleetOilControl {
  id             String       @id @default(cuid())
  vehicleId      String
  oilType        String
  lastChangeDate DateTime
  lastOdometer   Int?
  lastHourmeter  Decimal?
  intervalKm     Int?
  intervalHours  Decimal?
  intervalDays   Int?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  vehicle        FleetVehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model FleetBeltControl {
  id              String       @id @default(cuid())
  vehicleId       String
  beltType        String
  installedAt     DateTime
  installOdometer Int?
  installHourmeter Decimal?
  lifetimeKm      Int?
  lifetimeHours   Decimal?
  lifetimeDays    Int?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  vehicle         FleetVehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model FleetTire {
  id              String       @id @default(cuid())
  vehicleId       String
  position        String
  serialNumber    String?
  brand           String?
  model           String?
  installedAt     DateTime?
  installedKm     Int?
  estimatedLifeKm Int?
  status          String       @default("ACTIVE")
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  vehicle         FleetVehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([serialNumber])
}

model FleetSettings {
  id                          String                  @id @default("fleet")
  driverLicenseAlertDays      Int                     @default(30)
  maintenanceAlertDays        Int                     @default(30)
  oilAlertPercent             Int                     @default(80)
  beltAlertPercent            Int                     @default(80)
  primaryControlUnit          FleetPrimaryControlUnit @default(BOTH)
  vehicleTypes                String                  @default("Passeio\nCaminhao\nOnibus\nMaquina")
  fuelTypes                   String                  @default("Gasolina\nEtanol\nDiesel\nDiesel S10\nFlex")
  maintenanceTypes            String                  @default("Preventiva\nCorretiva\nPreditiva\nEmergencial")
  preventiveServiceTypes      String                  @default("Troca de oleo\nFiltro de oleo\nFiltro de ar\nCorreia\nRevisao geral\nAlinhamento\nBalanceamento\nPneus\nLubrificacao\nFreios")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
}
