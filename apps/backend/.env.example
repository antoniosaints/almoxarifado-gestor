DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
PORT=3333
FRONTEND_URL="http://127.0.0.1:5173"
JSON_BODY_LIMIT="1mb"

# Upload local por padrao. Se S3_BUCKET + chaves forem informados, o backend usa S3.
UPLOAD_DIR="uploads"
UPLOAD_MAX_BYTES=1048576
UPLOAD_PUBLIC_URL="/uploads"

# Exemplos de banco:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://usuario:senha@host:5432/almoxarifado?schema=public"
# DATABASE_PROVIDER="mysql"
# DATABASE_URL="mysql://usuario:senha@host:3306/almoxarifado"

# S3 opcional:
# S3_BUCKET="almoxarifado-uploads"
# S3_REGION="sa-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.seudominio.com"
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"
